NODE_ENV=development
PORT=4000

# Debe ser el mismo secreto HMAC-SHA256 (>= 32 caracteres) configurado en gr-user-microservice (JWT_SECRET)
JWT_SECRET=

ACCESS_TOKEN_COOKIE_NAME=access_token

CORS_ALLOWED_ORIGINS=http://localhost:3000

USER_SERVICE_URL=http://localhost:8080
WALL_SERVICE_URL=http://localhost:4100

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Contador de rate limiting compartido entre replicas del gateway. Si no esta
# disponible, el gateway sigue funcionando con un contador en memoria del proceso
# (deja de ser un limite global entre replicas, pero no tumba el servicio).
REDIS_URL=redis://localhost:6379

# --- Solo para docker-compose.yml (levanta el stack completo: postgres, redis,
# rabbitmq, user-microservice, wall-microservice y este gateway) ---
DB_USERNAME=postgres
DB_PASSWORD=postgres
INTERNAL_SERVICE_TOKEN=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
GATEWAY_PORT=4000
